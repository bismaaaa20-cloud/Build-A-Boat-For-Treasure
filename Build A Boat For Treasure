local function render()
    local lines = {"== KANDIDAT PETI (>> = terpilih) =="}
    for i, t in ipairs(Targets) do
        table.insert(lines, (i == Current and ">> " or "   ") .. i .. ". [" .. t.kind .. "] " .. t.inst:GetFullName())
    end
    table.insert(lines, "")
    table.insert(lines, "== LOG REMOTE SAAT TEST ==")
    for _, l in ipairs(log) do table.insert(lines, l) end
    Box.Text = table.concat(lines, "\n")
end

-- SCAN peti
local function Scan()
    setStatus("Memindai...")
    table.clear(Targets)
    local root = Workspace:FindFirstChild("BoatStages") or Workspace
    local seen, n = {}, 0
    for _, v in ipairs(root:GetDescendants()) do
        n = n + 1
        if n % 1000 == 0 then task.wait() end
        local kind
        if v:IsA("TouchTransmitter") then kind = "touch"
        elseif v:IsA("ProximityPrompt") then kind = "prompt"
        elseif v:IsA("ClickDetector") then kind = "click" end
        if kind then
            local part = v.Parent
            if part and part:IsA("Attachment") then part = part.Parent end
            local c = part and chain(part) or ""
            if part and part:IsA("BasePart") and not seen[part .. kind]
                and hasAny(c, cfg.Keywords) and not hasAny(c, cfg.Exclude)
                and not (part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")) then
                seen[part .. kind] = true
                table.insert(Targets, {kind = kind, inst = v, part = part,
                    prio = c:find("theend", 1, true) and 2 or (c:find("goldenchest", 1, true) and 1 or 0)})
            end
        end
    end
    table.sort(Targets, function(a, b) return a.prio > b.prio end)
    Current = 1
    setStatus(#Targets == 0 and "Peti tidak ditemukan. Dekati peti dulu lalu SCAN lagi."
        or (#Targets .. " kandidat. Teratas dipilih."))
    dirty = true
end

-- Spy ringan (hanya saat TEST/AUTO)
local function startHook()
    if hooked then return end
    if not (hookmetamethod and getnamecallmethod) then
        addLog("Executor tidak punya hookmetamethod, log remote tidak aktif.")
        return
    end
    local old
    old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
        local m = getnamecallmethod()
        if capture and (m == "FireServer" or m == "InvokeServer")
            and not (checkcaller and checkcaller()) and typeof(self) == "Instance" then
            local a = table.pack(...)
            local parts = {}
            for i = 1, a.n do parts[i] = tostring(a[i]):sub(1, 40) end
            local line = "[" .. m .. "] " .. self:GetFullName() .. "(" .. table.concat(parts, ", ") .. ")"
            task.spawn(addLog, line)
        end
        return old(self, ...)
    end))
    hooked = true
end

-- Interaksi
local function interact(t)
    if not t.inst or not t.inst.Parent then return false, "objek hilang, SCAN ulang" end
    local root = getRoot()
    if not root then return false, "karakter belum siap" end

    local plat = Instance.new("Part")
    plat.Name = "SteelAnchorPlatform"
    plat.Size = Vector3.new(40, 3, 40)
    plat.Anchored = true
    plat.Transparency = 0.3
    plat.BrickColor = BrickColor.new("Bright blue")
    plat.Material = Enum.Material.DiamondPlate
    plat.CFrame = t.part.CFrame * CFrame.new(0, -4.5, 0)
    plat.Parent = Workspace
    root.CFrame = t.part.CFrame * CFrame.new(0, 4, 0)
    task.wait(0.4)

    capture = true
    local ok, why = true, nil
    if t.kind == "touch" then
        if firetouchinterest then
            firetouchinterest(root, t.part, 0)
            task.wait(0.15)
            firetouchinterest(root, t.part, 1)
        else ok, why = false, "tidak ada firetouchinterest" end
    elseif t.kind == "prompt" then
        if fireproximityprompt then fireproximityprompt(t.inst) else ok, why = false, "tidak ada fireproximityprompt" end
    else
        if fireclickdetector then fireclickdetector(t.inst) else ok, why = false, "tidak ada fireclickdetector" end
    end
    task.wait(1.2)
    capture = false
    plat:Destroy()
    return ok, why
end

local function runOnce()
    local t = Targets[Current]
    if not t then setStatus("Belum ada target, SCAN dulu.") return end
    startHook()
    local ok, res, why = pcall(interact, t)
    if not ok then setStatus("Error: " .. tostring(res))
    elseif res then setStatus("Selesai menyentuh. Cek gold dan log di bawah.")
    else setStatus("Gagal: " .. tostring(why)) end
end

