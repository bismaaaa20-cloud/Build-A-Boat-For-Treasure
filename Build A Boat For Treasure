        TextXAlignment = Enum.TextXAlignment.Left}, f)
    local info = mk("TextLabel", {Size = UDim2.new(1, -16, 0, 12), Position = UDim2.new(0, 8, 0, 19),
        BackgroundTransparency = 1, Text = "Menunggu data...", TextColor3 = C.gray, Font = Enum.Font.Gotham,
        TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, f)
    local plot = mk("Frame", {Size = UDim2.new(1, -16, 1, -52), Position = UDim2.new(0, 8, 0, 34),
        BackgroundColor3 = Color3.fromRGB(16, 16, 22), BorderSizePixel = 0, ClipsDescendants = true}, f)
    mk("UICorner", {CornerRadius = UDim.new(0, 6)}, plot)
    for _, yy in ipairs({0.25, 0.5, 0.75}) do
        mk("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, yy, 0), BackgroundColor3 = C.white,
            BackgroundTransparency = 0.92, BorderSizePixel = 0}, plot)
    end
    local lines = mk("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0}, plot)
    mk("TextLabel", {Size = UDim2.new(1, -16, 0, 12), Position = UDim2.new(0, 8, 1, -16), BackgroundTransparency = 1,
        Text = "per " .. ChartInterval .. " detik", TextColor3 = C.gray, Font = Enum.Font.Gotham, TextSize = 10,
