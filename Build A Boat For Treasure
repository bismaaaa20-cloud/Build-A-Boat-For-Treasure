local function fmt(n)
    local s = tostring(math.floor(n + 0.5))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    if out:sub(1, 1) == "," then out = out:sub(2) end
    return out
end

local function timeText()
    local e = os.time() - StartTime
    return string.format("%02d:%02d:%02d", math.floor(e / 3600), math.floor((e % 3600) / 60), e % 60)
end

local function perHour()
    local e = os.time() - StartTime
    return e > 0 and LiveTotalGold / (e / 3600) or 0
end

local function avgRound()
    return RoundsMeasured > 0 and RoundGainSum / RoundsMeasured or 0
end

-- ================= FPS =================
local fps = 0
do
    local frames, t0 = 0, os.clock()
    RunService.Heartbeat:Connect(function()
        if not alive() then return end
        frames = frames + 1
        local now = os.clock()
        if now - t0 >= 1 then
            fps = math.floor(frames / (now - t0) + 0.5)
            frames, t0 = 0, now
        end
    end)
end

