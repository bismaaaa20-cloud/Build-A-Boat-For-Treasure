            vGold.Text = fmt(v)
        else
            vGold.Text = "N/A"
        end

        if BlockObj then
            local b = BlockObj.Value
            if lastB and b > lastB then LiveBlockGain = LiveBlockGain + (b - lastB) end
            lastB = b
            vBlock.Text = fmt(b)
        else
            vBlock.Text = "N/A"
        end

        vGoldGain.Text = "+" .. fmt(LiveTotalGold)
        vBlockGain.Text = "+" .. fmt(LiveBlockGain)
        vChest.Text = ChestOK .. " / " .. ChestTries
        vChestBlock.Text = "+" .. fmt(ChestBlockSum)
        vLast.Text = "+" .. fmt(LastGain)
        vAvg.Text = fmt(avgRound())
        vRate.Text = fmt(perHour())
        vRounds.Text = tostring(LiveTotalBlocks)
        vTime.Text = timeText()
        vFps.Text = tostring(fps)

        task.wait(0.3)
    end
end)

