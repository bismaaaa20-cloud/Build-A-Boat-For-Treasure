local ReasonColor = { ["Mulai"] = 3447003, ["Update"] = 5763719, ["Berhenti"] = 15548997 }

local function SendWebhookLog(reason, statusText)
    local w = cfg["Webhook"]
    local url = w["UrlWebhook"]
    if not w["Enable"] or url == "" then return end
    if not httpRequest then warn("[Webhook] executor tidak punya fungsi request") return end
    if not (url:find("discord.com/api/webhooks/", 1, true) or url:find("discordapp.com/api/webhooks/", 1, true)) then
        warn("[Webhook] URL tidak valid")
        return
    end
    if reason == "Update" and os.clock() - lastSend < 5 then return end
    lastSend = os.clock()

    local embed = {
        title = "AFK Farm Ming  |  " .. tostring(reason),
        description = "**" .. DisplayName .. "**\nStatus: `" .. tostring(statusText or "-") .. "`",
        color = ReasonColor[reason] or 15105570,
        fields = {
            {name = "Gold", value = "`" .. (GoldObj and fmt(GoldObj.Value) or "-") .. "`", inline = true},
            {name = "Gold Naik", value = "`+" .. fmt(LiveTotalGold) .. "`", inline = true},
            {name = "Ronde Terakhir", value = "`+" .. fmt(LastGain) .. "`", inline = true},
            {name = "Gold Block", value = "`" .. (BlockObj and fmt(BlockObj.Value) or "-") .. "`", inline = true},
            {name = "Block Naik", value = "`+" .. fmt(LiveBlockGain) .. "`", inline = true},
            {name = "Rounds", value = "`" .. LiveTotalBlocks .. "`", inline = true},
            {name = "Peti", value = "`" .. ChestOK .. "/" .. ChestTries .. "`", inline = true},
            {name = "Block dari Peti", value = "`+" .. fmt(ChestBlockSum) .. "`", inline = true},
            {name = "Gold/Jam", value = "`" .. fmt(perHour()) .. "`", inline = true},
            {name = "Rata-rata/Ronde", value = "`" .. fmt(avgRound()) .. "`", inline = true},
            {name = "Waktu", value = "`" .. timeText() .. "`", inline = true},
        },
        footer = {text = "AFK Farm Ming  |  Kaitun"},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    if avatarUrl and not cfg["UI"]["Hide_Username"] then
        embed.thumbnail = {url = avatarUrl}
    end

    local body = HttpService:JSONEncode({username = "AFK Farm Ming", embeds = {embed}})

    task.spawn(function()
        local ok, res = pcall(httpRequest, {
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
        if not ok then
            warn("[Webhook] " .. tostring(res))
        elseif type(res) == "table" and res.StatusCode and res.StatusCode >= 400 then
            warn("[Webhook] gagal, kode " .. res.StatusCode)
        end
    end)
end

