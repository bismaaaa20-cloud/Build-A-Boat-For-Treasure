local function segment(parent, x1, y1, x2, y2, color)
    local dx, dy = x2 - x1, y2 - y1
    local len = math.sqrt(dx * dx + dy * dy)
    mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, len, 0, 2),
        Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2),
        Rotation = math.deg(math.atan2(dy, dx)),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)
end

local function dot(parent, x, y, color, size)
    local d = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, size, 0, size),
        Position = UDim2.new(0, x, 0, y),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)
    mk("UICorner", {CornerRadius = UDim.new(1, 0)}, d)
end

local function redraw(chart)
    local size = chart.plot.AbsoluteSize
    if size.X < 20 or size.Y < 20 then return end
    chart.lines:ClearAllChildren()

    local data = chart.data
    local n = #data
    if n == 0 then
        chart.info.Text = "Menunggu data..."
        return
    end

    local maxV = 1
    for _, v in ipairs(data) do
        if v > maxV then maxV = v end
    end
    chart.info.Text = "Terakhir +" .. fmt(data[n]) .. "  Maks +" .. fmt(maxV)

    local pad = 8
    local w, h = size.X - pad * 2, size.Y - pad * 2
    local prevX, prevY
    for i = 1, n do
        local x = pad + ((i - 1) / math.max(1, MaxPoints - 1)) * w
        local y = pad + h - (data[i] / maxV) * h
        if prevX then segment(chart.lines, prevX, prevY, x, y, chart.color) end
        dot(chart.lines, x, y, chart.color, i == n and 8 or 5)
        prevX, prevY = x, y
    end
end

local function makeChart(title, color)
    local f = mk("Frame", {Size = UDim2.new(0.5, -4, 1, 0), BackgroundColor3 = C.tile, BorderSizePixel = 0}, ChartPage)
    mk("UICorner", {CornerRadius = UDim.new(0, 8)}, f)
