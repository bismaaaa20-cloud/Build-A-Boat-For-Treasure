-- ================= UTIL =================
local function CreateSteelPlatform()
    local part = Instance.new("Part")
    part.Name = "SteelAnchorPlatform"
    part.Size = Vector3.new(40, 3, 40)
    part.Anchored = true
    part.Transparency = 0.3
    part.BrickColor = BrickColor.new("Bright blue")
    part.Material = Enum.Material.DiamondPlate
    part.Parent = Workspace
    return part
end

local function getRoot()
    local char = client.Character or client.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart", 10)
end

local function claim()
    if not ClaimRemote then return end
    if ClaimRemote:IsA("RemoteEvent") then
        ClaimRemote:FireServer()
    elseif ClaimRemote:IsA("RemoteFunction") then
        ClaimRemote:InvokeServer()
    end
end

local function getStageList()
    local list = {}
    for i = 1, MaxStageScan do
        local s = Stages:FindFirstChild("CaveStage" .. i)
        local dark = s and s:FindFirstChild("DarknessPart")
        if dark then
            table.insert(list, {index = i, part = dark})
        end
    end
    return list
end

-- ================= PETI =================
local function findTrigger()
    local t = cfg["Chest"]["FindTimeout"]
    local en = Stages:FindFirstChild("TheEnd") or Stages:WaitForChild("TheEnd", t)
    local ch = en and (en:FindFirstChild("GoldenChest") or en:WaitForChild("GoldenChest", t))
    local trig = ch and (ch:FindFirstChild("Trigger") or ch:WaitForChild("Trigger", t))
    if not trig and BoatStages then
        local alt = BoatStages:FindFirstChild("GoldenChest", true)
        trig = alt and alt:FindFirstChild("Trigger")
    end
    return trig
end

local function fireTouch(trigger)
    if not firetouchinterest then return end
    local char = client.Character
    if not char then return end
    local parts = {}
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") and #parts < 6 then table.insert(parts, p) end
    end
    for _, p in ipairs(parts) do
        pcall(firetouchinterest, p, trigger, 0)
    end
    task.wait(0.1)
    for _, p in ipairs(parts) do
        pcall(firetouchinterest, p, trigger, 1)
    end
end

local function TouchChest(platform)
    if not cfg["Chest"]["Enable"] then return end
    StatusLabel.Text = "Mencari peti akhir..."
    local trigger = findTrigger()
    if not (trigger and trigger:IsA("BasePart")) then
        StatusLabel.Text = "Peti: Trigger tidak ditemukan"
        return
    end

    ChestTries = ChestTries + 1
    local beforeB = BlockObj and BlockObj.Value
    local beforeG = GoldObj and GoldObj.Value
    local got = false
    local offsets = {
        Vector3.new(0, 0, 0), Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0),
        Vector3.new(0, 0, 5), Vector3.new(0, 0, -5), Vector3.new(0, 0, 0)
    }

    for attempt = 1, cfg["Chest"]["Retries"] do
        if not env.Busy or not alive() then return end
        local root = getRoot()
        if not root then break end

        platform.CFrame = trigger.CFrame * CFrame.new(0, -4.5, 0)
        StatusLabel.Text = "Peti: percobaan " .. attempt .. "/" .. cfg["Chest"]["Retries"]

        -- masuk ke zona peti dan bergerak sedikit supaya sentuhan terdeteksi server
        for _, off in ipairs(offsets) do
            root.CFrame = trigger.CFrame + off
            task.wait(0.2)
        end
        fireTouch(trigger)

        -- tunggu gold block naik
        local t0 = os.clock()
        while os.clock() - t0 < cfg["Chest"]["Wait_Reward"] do
            if BlockObj and beforeB and BlockObj.Value > beforeB then got = true break end
            task.wait(0.25)
        end
        if got then break end
    end

    local gainG = (GoldObj and beforeG) and math.max(0, GoldObj.Value - beforeG) or 0
    if got then
        ChestOK = ChestOK + 1
        local d = BlockObj.Value - beforeB
        ChestBlockSum = ChestBlockSum + d
        StatusLabel.Text = "Peti berhasil: +" .. fmt(d) .. " gold block"
    elseif not BlockObj then
        StatusLabel.Text = "Peti disentuh (gold block tidak terbaca)"
    else
        StatusLabel.Text = "Peti: tidak ada gold block (+" .. fmt(gainG) .. " gold)"
    end

    if cfg["Chest"]["Claim_After"] then claim() end
    task.wait(1)
end

