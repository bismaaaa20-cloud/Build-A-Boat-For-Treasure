local function fill(target, defaults)
    for k, v in pairs(defaults) do
        if target[k] == nil then
            target[k] = (type(v) == "table") and fill({}, v) or v
        elseif type(v) == "table" and type(target[k]) == "table" then
            fill(target[k], v)
        end
    end
    return target
end

