-- Loop
task.spawn(function()
    while gui.Parent do
        if dirty then dirty = false render() end
        if _G.Busy and Targets[Current] then
            runOnce()
            task.wait(cfg.Interval)
        else
            task.wait(0.5)
        end
    end
end)

