task.spawn(function()
    while screenGui.Parent and alive() do
        if not env.Busy then
            StatusLabel.Text = "Status: Berhenti"
            task.wait(0.5)
        else
            local platform = CreateSteelPlatform()

            local ok, err = pcall(function()
                local list = getStageList()
                if #list == 0 then
                    StatusLabel.Text = "Status: Stage tidak ditemukan"
                    task.wait(3)
                    return
                end

                local roundStartG = GoldObj and GoldObj.Value
                local roundStartB = BlockObj and BlockObj.Value

                for _, st in ipairs(list) do
                    if not env.Busy or not alive() then return end
                    local root = getRoot()
                    if root then
                        local before = GoldObj and GoldObj.Value
                        root.CFrame = st.part.CFrame
                        platform.CFrame = st.part.CFrame * CFrame.new(0, -4.5, 0)
                        claim()
                        StatusLabel.Text = "Farming: Stage " .. st.index .. "/" .. #list
                        task.wait(StageWaits[st.index] or DefaultWait)
                        if before and GoldObj then
                            local d = GoldObj.Value - before
                            StatusLabel.Text = "Stage " .. st.index .. "/" .. #list .. ": +" .. fmt(math.max(d, 0)) .. " gold"
                        end
                    end
                end

                if not env.Busy or not alive() then return end
                TouchChest(platform)

                if roundStartG and GoldObj then
                    local g = GoldObj.Value - roundStartG
                    if g >= 0 then
                        LastGain = g
                        RoundGainSum = RoundGainSum + g
                        RoundsMeasured = RoundsMeasured + 1
                    end
                end
                if roundStartB and BlockObj then
                    LastBlockGain = math.max(0, BlockObj.Value - roundStartB)
                end

                LiveTotalBlocks = LiveTotalBlocks + cfg["Setting_Farm"]["Gold_Block_Per_Round"]
                if LiveTotalBlocks % math.max(1, cfg["Webhook"]["Webhook_Every"]) == 0 then
                    SendWebhookLog("Update", StatusLabel.Text)
                end
                if Penguin then Penguin:FireServer("PenguinCharacter") end
            end)

            platform:Destroy()
            if not ok then
                warn("[AFK Farm Ming] " .. tostring(err))
                StatusLabel.Text = "Error, mengulang..."
            end
            task.wait(2)
        end
    end
end)
